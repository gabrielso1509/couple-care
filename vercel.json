{
    "headers": [
        {
            "source": "/src/:type(css|js)/:file*",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=300" }
            ]
        }
    ],
    "rewrites":  [
                     {
                         "source":  "/dashboard",
                         "destination":  "/src/dashboard.html"
                     },
                     {
                         "source":  "/tarefas",
                         "destination":  "/src/tarefas.html"
                     },
                     {
                         "source":  "/calendario",
                         "destination":  "/src/calendario.html"
                     },
                     {
                         "source":  "/menstruacao",
                         "destination":  "/src/menstruacao.html"
                     },
                     {
                         "source":  "/financas",
                         "destination":  "/src/financas.html"
                     },
                     {
                         "source":  "/relatorios",
                         "destination":  "/src/relatorios.html"
                     },
                     {
                         "source":  "/configuracoes",
                         "destination":  "/src/config.html"
                     },
                     {
                         "source":  "/bem-estar",
                         "destination":  "/src/menstruacao.html"
                     }
                 ],
    "redirects":  [
                      {"source":"/nosso-espaco","destination":"/dashboard","permanent":false},
                      {"source":"/src/espaco.html","destination":"/dashboard","permanent":false},
                      {
                          "source":  "/src/index.html",
                          "destination":  "/dashboard",
                          "permanent":  true
                      }
                  ]
}